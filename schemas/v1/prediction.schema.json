{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arthroscan.ner/schemas/v1/prediction.schema.json",
  "title": "ScreeningResult",
  "description": "Unified multimodal screening result with uncertainty and explainability",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "patient_id": { "type": "string" },
    "risk_category": {
      "type": "string",
      "enum": ["LOWER_SCREENING_RISK", "MODERATE_SCREENING_RISK", "HIGHER_SCREENING_RISK", "HIGH_UNCERTAINTY_RETEST"]
    },
    "risk_probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "uncertainty_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence_coverage": { "type": "string" },
    "available_modalities": { "type": "array", "items": { "type": "string" } },
    "missing_modalities": { "type": "array", "items": { "type": "string" } },
    "referral_recommendation": {
      "type": "string",
      "enum": ["ROUTINE_FOLLOW_UP", "CLINICAL_EVALUATION_RECOMMENDED", "EARLIER_CLINICAL_EVALUATION_RECOMMENDED", "RETEST_REQUIRED"]
    },
    "modality_scores": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "model_version": { "type": "string" },
    "feature_schema_version": { "type": "string" },
    "preprocessing_version": { "type": "string" },
    "timestamp": { "type": "integer" },
    "is_synthetic": { "type": "boolean" },
    "disclaimer": { "type": "string" },
    "schema_version": { "type": "string" }
  },
  "required": ["session_id", "risk_category", "confidence", "uncertainty_score", "referral_recommendation", "schema_version"]
}
