{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arthroscan.ner/schemas/v1/screening_result.schema.json",
  "title": "ScreeningResult",
  "description": "Multimodal screening risk output and referral recommendation",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "session_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "risk_tier": {
      "type": "string",
      "enum": ["LOWER_SCREENING_RISK", "MODERATE_SCREENING_RISK", "HIGHER_SCREENING_RISK", "HIGH_UNCERTAINTY_RETEST"]
    },
    "risk_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "uncertainty": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence_coverage": { "type": "string" },
    "available_modalities": { "type": "array", "items": { "type": "string" } },
    "signal_quality_summary": { "type": "string", "enum": ["EXCELLENT", "GOOD", "DEGRADED", "UNACCEPTABLE"] },
    "screening_interpretation": { "type": "string" },
    "referral_recommendation": {
      "type": "string",
      "enum": ["ROUTINE_FOLLOW_UP", "CLINICAL_EVALUATION_RECOMMENDED", "EARLIER_CLINICAL_EVALUATION_RECOMMENDED", "RETEST_REQUIRED"]
    },
    "is_synthetic": { "type": "boolean" },
    "disclaimer": { "type": "string" }
  },
  "required": [
    "schema_version",
    "session_id",
    "subject_id",
    "risk_tier",
    "confidence",
    "uncertainty",
    "evidence_coverage",
    "screening_interpretation",
    "referral_recommendation",
    "disclaimer"
  ]
}
